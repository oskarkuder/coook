# ---------------------------------------------------------------------------
# Coook! environment variables
# Copy to .env.local for local dev, and paste the same set into Vercel.
# See SETUP.md for where each value comes from.
# ---------------------------------------------------------------------------

# --- Demo mode ---------------------------------------------------------------
# 1 = run the whole app with a fake signed-in user and an in-memory store.
#     Nothing below is required. Use it to click through the UI before any
#     account exists. Add OPENAI_API_KEY to also do real video extraction.
# 0 = the real thing: Supabase + Stripe, everything below required.
NEXT_PUBLIC_DEMO_MODE=1

# --- Supabase (new project) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
# No trailing slash. Local: http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# --- OpenAI ------------------------------------------------------------------
OPENAI_API_KEY=
# Model that turns caption + transcript into a structured recipe.
OPENAI_MODEL=gpt-4.1-mini
# Model used to transcribe the video audio.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the $10/month recurring price.
STRIPE_PRICE_MONTHLY=
# Price ID of the €30/year recurring price.
STRIPE_PRICE_YEARLY=

# --- Optional: third-party media resolver ------------------------------------
# Instagram (and sometimes TikTok) block direct server-side video fetches from
# datacenter IPs, which is where Vercel runs. Without a resolver the app still
# works from captions and asks the user to paste text when a post yields
# nothing — but audio transcription needs a real media URL.
#
# Pick one provider:
#   apify     Apify actor, run synchronously. Most reliable. Pay per run.
#             KEY = Apify API token. Optionally set MEDIA_RESOLVER_ACTOR.
#   rapidapi  Any RapidAPI TikTok/Instagram downloader. Cheapest, least stable.
#             URL = the full endpoint, KEY = your RapidAPI key.
#   custom    Your own service answering GET ?url=… with JSON.
#
# Leave MEDIA_RESOLVER_PROVIDER blank to disable resolving entirely.
MEDIA_RESOLVER_PROVIDER=
MEDIA_RESOLVER_URL=
MEDIA_RESOLVER_KEY=
MEDIA_RESOLVER_ACTOR=truefetch~best-video-downloader
