# ---------------------------------------------------------------------------
# Coook! environment variables
# Copy to .env.local for local dev, and paste the same set into Vercel.
# See SETUP.md for where each value comes from.
# ---------------------------------------------------------------------------

# --- Demo mode ---------------------------------------------------------------
# 1 = run the whole app with a fake signed-in user and an in-memory store.
#     Supabase and Stripe are not needed. OPENAI_API_KEY still is, if you
#     want real extraction rather than just clicking through the UI.
# 0 = the real thing: Supabase + Stripe, everything below required.
NEXT_PUBLIC_DEMO_MODE=1

# --- Supabase (new project) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---------------------------------------------------------------------
# No trailing slash. Local: http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# --- OpenAI ------------------------------------------------------------------
# Required. Every import is transcribed and structured, so the app needs a key.
OPENAI_API_KEY=
# Turns caption + transcript into the structured recipe.
OPENAI_MODEL=gpt-4.1-mini
# Transcribes the video audio.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# --- Stripe ------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID of the $10/month recurring price.
STRIPE_PRICE_MONTHLY=
# Price ID of the €30/year recurring price.
STRIPE_PRICE_YEARLY=

# --- Media resolver ----------------------------------------------------------
# TikTok and Instagram block server-side video fetches from datacenter IPs,
# which is where Vercel runs. Without a resolver, transcription silently stops
# working in production even though it works on your laptop.
#
# Recommended: TikHub — pay-as-you-go, roughly $0.001-0.01 per request, no
# monthly minimum. At those rates it costs about the same as the AI does.
#   MEDIA_RESOLVER_PROVIDER=custom
#   MEDIA_RESOLVER_URL=<the endpoint from their docs>
#   MEDIA_RESOLVER_KEY=<your key>
#   MEDIA_RESOLVER_METHOD=GET        # or POST
#   MEDIA_RESOLVER_PARAM=url         # the query/body field holding the link
#
# Alternatives: SocialKit ($13/mo flat, simple), Apify (most reliable but
# ~$0.28 per download, which is far more than everything else here combined).
#
# Leave MEDIA_RESOLVER_PROVIDER blank to disable. The app still reads captions
# and still works — you just lose speech-only videos.
MEDIA_RESOLVER_PROVIDER=
MEDIA_RESOLVER_URL=
MEDIA_RESOLVER_KEY=
MEDIA_RESOLVER_METHOD=GET
MEDIA_RESOLVER_PARAM=url
MEDIA_RESOLVER_AUTH_HEADER=Authorization
MEDIA_RESOLVER_AUTH_PREFIX=Bearer 
# apify only:
MEDIA_RESOLVER_ACTOR=truefetch~best-video-downloader
